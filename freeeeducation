    function filterToSlug(name) {
      if (name === "home") return "";
      if (name === "popular") return "popular";
      if (name === "new") return "new";
      if (name === "all") return "all";
      if (name === "suggestions") return "suggestions";
      return "";
    }

    function slugToFilter(slug) {
      if (!slug || slug === "home") return "home";
      if (slug === "popular") return "popular";
      if (slug === "new") return "new";
      if (slug === "all") return "all";
      if (slug === "suggestions") return "suggestions";
      return null;
    }

