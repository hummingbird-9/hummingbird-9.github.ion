
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Free Education • Play Free Web Games</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    :root {
      --bg-page: #0b0b0b;
      --bg-page-top: #020d14;
      --bg-page-bottom: #000000;
      --bg-card: #030a10;
      --bg-card-soft: #04101a;

      --accent-main: #8b5cf6;   /* old red: #38bdf8  old orange: #f97316  old green: #22c55e */
      --accent-soft: #a78bfa;   /* old red: #60cbfa */
      --accent-warm: #c4b5fd;   /* old red: #93d9fb */

      --text-main: #f9fafb;
      --text-muted: #b1b5bf;
      --text-softer: #7b818c;
      --radius-lg: 18px;
      --radius-md: 14px;
      --radius-pill: 999px;
      --border-subtle: rgba(148, 163, 184, 0.3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top, #021018 0, #000000 65%),
        linear-gradient(to bottom, var(--bg-page-top), var(--bg-page-bottom));
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      padding: 18px 10px 26px;
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(to right, rgba(28, 18, 12, 0.75) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(28, 18, 12, 0.6) 1px, transparent 1px);
      background-size: 120px 120px;
      opacity: 0.3;
      pointer-events: none;
      z-index: -1;
    }

    .page-wrap {
      width: 100%;
      max-width: 1320px;
      padding: 18px 20px 18px;
      margin: 0 auto;
      position: relative;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .header-main {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .app-icon {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      background: radial-gradient(circle at 20% 0%, var(--accent-main), #020d14 55%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 14px 26px rgba(0, 0, 0, 0.9);
      position: relative;
      overflow: hidden;
      animation: floatSoft 6s ease-in-out infinite alternate;
    }

    .app-icon::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 0 0, rgba(255, 255, 255, 0.22), transparent 45%);
      opacity: 0.7;
      mix-blend-mode: screen;
      pointer-events: none;
    }

    .app-icon-inner {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(148, 163, 184, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    @keyframes floatSoft {
      0% { transform: translateY(0); }
      100% { transform: translateY(-4px); }
    }

    .title-block {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .title {
      font-weight: 800;
      font-size: 26px;
      letter-spacing: 0.02em;
    }

    .subtitle {
      font-size: 13px;
      color: var(--text-muted);
    }

    .header-tag {
      font-size: 11px;
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(167, 139, 250, 0.45);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--accent-warm);
      background: rgba(8, 20, 28, 0.9);
    }

    .search-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 14px;
    }

    .search-box {
      background: rgba(24, 14, 8, 0.95);
      border-radius: 14px;
      border: 1px solid var(--border-subtle);
      padding: 8px 12px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .search-icon {
      opacity: 0.75;
      font-size: 15px;
    }

    .search-box input {
      flex: 1;
      border: none;
      background: transparent;
      color: var(--text-main);
      font-size: 14px;
      outline: none;
    }

    .filter-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .filter-pill {
      padding: 5px 13px;
      border-radius: var(--radius-pill);
      font-size: 12px;
      border: 1px solid rgba(148, 163, 184, 0.5);
      color: var(--text-softer);
      cursor: pointer;
      background: rgba(24, 14, 8, 0.85);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition:
        transform 0.08s ease-out,
        box-shadow 0.08s ease-out,
        border-color 0.08s,
        background 0.08s,
        color 0.08s;
    }

    .filter-pill span.icon {
      font-size: 14px;
    }

    .filter-pill.active {
      background: radial-gradient(circle at 0 0, rgba(139, 92, 246, 0.28), #030a10);
      border-color: rgba(167, 139, 250, 0.95);
      color: #fff0f2;
      box-shadow: 0 8px 16px rgba(15, 23, 42, 0.9);
      transform: translateY(-1px);
    }

    .filter-pill:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.6);
    }

    .home-panel {
      display: none;
      margin-top: 8px;
    }

    .home-card {
      max-width: 1020px;
      margin: 0 auto 16px;
      background: linear-gradient(145deg, rgba(24, 10, 4, 0.96), rgba(8, 8, 8, 0.96));
      border-radius: var(--radius-lg);
      border: 1px solid rgba(167, 139, 250, 0.28);
      padding: 26px 24px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.7);
    }

    .home-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--accent-warm);
      margin-bottom: 10px;
    }

    .home-title-main {
      font-size: 34px;
      line-height: 1.05;
      font-weight: 900;
      margin-bottom: 10px;
    }

    .home-text-main {
      color: var(--text-muted);
      font-size: 15px;
      line-height: 1.55;
      max-width: 760px;
    }

    .home-grid {
      max-width: 1020px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 14px;
    }

    .home-box {
      background: linear-gradient(145deg, rgba(18, 9, 4, 0.96), rgba(10, 10, 10, 0.96));
      border-radius: 16px;
      border: 1px solid rgba(167, 139, 250, 0.2);
      padding: 18px;
      min-height: 140px;
      box-shadow: 0 14px 24px rgba(0, 0, 0, 0.45);
    }

    .home-box h3 {
      font-size: 18px;
      margin-bottom: 8px;
      color: #fff7f2;
    }

    .home-box p {
      color: var(--text-muted);
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 2px;
    }

    .home-box br {
      display: block;
      content: "";
      margin-top: 0.65em;
    }

    .home-box h4 {
      font-size: 13px;
      font-weight: 700;
      color: var(--accent-warm);
      margin-bottom: 4px;
    }

    .cards-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 230px));
      justify-content: center;
      gap: 14px;
      margin-top: 8px;
      grid-auto-rows: 1fr;
    }

    .game-card {
      position: relative;
      background: linear-gradient(145deg, var(--bg-card), #020617);
      border-radius: var(--radius-lg);
      padding: 10px 10px 10px;
      color: var(--text-main);
      cursor: pointer;
      box-shadow: 0 14px 24px rgba(0, 0, 0, 0.9);
      border: 1px solid rgba(51, 65, 85, 0.9);
      overflow: hidden;
      text-decoration: none;
      transition:
        transform 0.13s ease-out,
        box-shadow 0.13s ease-out,
        border-color 0.13s,
        background 0.13s;
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 250px;
    }

    .game-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 36px rgba(0, 0, 0, 0.95);
      border-color: rgba(167, 139, 250, 0.72);
      background: linear-gradient(145deg, var(--bg-card-soft), #020617);
    }

    .badge-row {
      height: 20px;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: linear-gradient(120deg, #ddd6fe, #8b5cf6);
      padding: 2px 9px;
      border-radius: var(--radius-pill);
      font-size: 11px;
      font-weight: 600;
      color: #0c2a40;
    }

    .badge-pill.badge-new {
      background: linear-gradient(120deg, #f3e8ff, #a78bfa);
      color: #0c3a5a;
    }

    .game-thumb {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 14px;
      overflow: hidden;
      background: #020617;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .game-thumb.no-img {
      background: radial-gradient(circle at 0 0, var(--accent-main), #020d14 60%);
    }

    .game-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .play-circle {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) scale(0.9);
      opacity: 0;
      width: 46px;
      height: 46px;
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(248, 250, 252, 0.9);
      box-shadow: 0 14px 26px rgba(0, 0, 0, 0.85);
      transition:
        opacity 0.1s ease-out,
        transform 0.1s ease-out,
        box-shadow 0.1s ease-out;
      pointer-events: none;
    }

    .game-card:hover .play-circle {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.03);
      box-shadow: 0 20px 34px rgba(0, 0, 0, 0.95);
    }

    .play-icon {
      width: 0;
      height: 0;
      border-top: 8px solid transparent;
      border-bottom: 8px solid transparent;
      border-left: 14px solid rgba(255, 255, 255, 0.98);
      margin-left: 3px;
    }

    .card-bottom {
      margin-top: auto;
      padding-top: 8px;
    }

    .game-title {
      font-weight: 700;
      font-size: 15px;
      margin-bottom: 2px;
    }

    .game-desc {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 5px;
    }

    .play-link {
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: #ffece1;
      opacity: 0.9;
    }

    .play-link span.arrow {
      font-size: 13px;
      transform: translateY(1px);
    }

    .play-link:hover {
      opacity: 1;
    }

    .suggestions-panel {
      display: none;
      margin-top: 16px;
    }

    .suggest-card {
      max-width: 900px;
      margin: 0 auto 16px;
      background: rgba(24, 12, 6, 0.9);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-subtle);
      padding: 18px 20px;
      text-align: left;
      line-height: 1.5;
      font-size: 14px;
    }

    .suggest-card h2 {
      margin-bottom: 8px;
      font-size: 18px;
    }

    .suggest-text {
      color: var(--text-muted);
      font-size: 13px;
    }

    .suggestions-panel iframe {
      width: 100%;
      max-width: 900px;
      height: 700px;
      border: none;
      border-radius: var(--radius-lg);
      display: block;
      margin: 0 auto;
    }

    .footer {
      margin-top: 18px;
      text-align: left;
      font-size: 11px;
      color: var(--text-softer);
    }

    .player-overlay {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, 0.96);
      transform: translateX(100%);
      transition: transform 0.25s ease-out;
      z-index: 50;
      display: flex;
      flex-direction: column;
    }

    .player-overlay.open {
      transform: translateX(0);
    }

    .player-overlay.from-left {
      transform: translateX(-100%);
    }

    .player-frame-wrap {
      position: relative;
      flex: 1;
      display: flex;
      align-items: stretch;
      justify-content: stretch;
      background: radial-gradient(circle at top, #021018, #000000 60%);
    }

    #gameFrame {
      border: none;
      width: 100%;
      height: 100%;
      background: #000;
    }

    .top-bar {
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      height: 50px;
      max-width: 980px;
      width: calc(100% - 40px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px;
      background: rgba(24, 12, 6, 0.74);
      backdrop-filter: blur(16px);
      border-radius: 999px;
      border: 1px solid rgba(167, 139, 250, 0.35);
      z-index: 20;
      font-size: 13px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.85);
    }

    .top-left {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
      min-width: 0;
    }

    .top-dot {
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: var(--accent-main);
      box-shadow: 0 0 10px rgba(139, 92, 246, 0.9);
      animation: pulse 1.3s infinite;
      flex-shrink: 0;
    }

    @keyframes pulse {
      0% { transform: scale(1); opacity: 1; }
      100% { transform: scale(1.35); opacity: 0.35; }
    }

    .top-buttons {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }

    .btn {
      border-radius: var(--radius-pill);
      padding: 6px 11px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      background: rgba(15, 23, 42, 0.95);
      color: #f9fafb;
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition:
        background 0.12s,
        transform 0.12s,
        box-shadow 0.12s,
        opacity 0.12s,
        border-color 0.12s;
    }

    .btn:hover {
      background: #020617;
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.8);
      border-color: rgba(167, 139, 250, 0.88);
    }

    .btn-danger {
      border-color: rgba(248, 113, 113, 0.85);
      background: rgba(24, 24, 27, 0.92);
    }

    .btn-danger:hover {
      background: #7f1d1d;
    }

    .loading-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at top, #021018, #000000 58%);
      z-index: 15;
      flex-direction: column;
      gap: 12px;
      transition: opacity 0.22s ease-out, visibility 0.22s ease-out;
    }

    .loading-overlay.hidden {
      opacity: 0;
      visibility: hidden;
    }

    .spinner {
      width: 46px;
      height: 46px;
      border-radius: 999px;
      border: 4px solid rgba(148, 163, 184, 0.18);
      border-top-color: var(--accent-main);
      border-right-color: var(--accent-soft);
      animation: spin 0.9s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .loading-text {
      font-size: 13px;
      color: #e5e7eb;
    }

    @media (max-width: 900px) {
      #cheeseCredit {
        display: none !important;
      }
    }

    /* ── Light Mode ─────────────────────────────────────────────────── */
    :root.light-mode {
      --bg-page: #f5f5f5;
      --bg-page-top: #faf5ff;
      --bg-page-bottom: #ebebeb;
      --bg-card: #ffffff;
      --bg-card-soft: #f3e8ff;
      --text-main: #111827;
      --text-muted: #4b5563;
      --text-softer: #9ca3af;
      --border-subtle: rgba(0,0,0,0.12);
    }

    :root.light-mode body {
      background: radial-gradient(circle at top, #ffe0c0 0, #f2f2f2 70%) !important;
      color: var(--text-main);
    }

    :root.light-mode body::before {
      background-image:
        linear-gradient(to right, rgba(180,150,130,0.18) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(180,150,130,0.12) 1px, transparent 1px);
    }

    :root.light-mode .game-card {
      background: linear-gradient(145deg, #fff, #f7f7f7) !important;
      border-color: rgba(0,0,0,0.09) !important;
      box-shadow: 0 4px 14px rgba(0,0,0,0.07) !important;
    }

    :root.light-mode .game-card:hover {
      border-color: rgba(139,92,246,0.5) !important;
      background: linear-gradient(145deg, #fffaf8, #f7f7f7) !important;
    }

    :root.light-mode .filter-pill {
      background: rgba(255,255,255,0.9) !important;
      color: #374151 !important;
    }

    :root.light-mode .filter-pill.active {
      background: radial-gradient(circle at 0 0, rgba(139,92,246,0.12), #f3e8ff) !important;
      color: #1f2937 !important;
    }

    :root.light-mode .search-box {
      background: rgba(255,255,255,0.95) !important;
    }

    :root.light-mode .search-box input { color: #111827 !important; }

    :root.light-mode .home-card,
    :root.light-mode .home-box,
    :root.light-mode .suggest-card {
      background: linear-gradient(145deg, #fff, #f8f8f8) !important;
      border-color: rgba(0,0,0,0.09) !important;
    }

    :root.light-mode .top-bar { background: rgba(255,255,255,0.88) !important; }
    :root.light-mode .btn { background: rgba(255,255,255,0.95) !important; color: #1a1a1a !important; border-color: rgba(0,0,0,0.2) !important; }
    :root.light-mode .home-label { color: var(--accent-main); }
    :root.light-mode .home-title-main { color: #111; }
    :root.light-mode .home-text-main { color: #4b5563; }
    :root.light-mode .home-box h3 { color: #111; }
    :root.light-mode .home-box p { color: #6b7280; }
    :root.light-mode .footer { color: #9ca3af; }
    :root.light-mode .title { color: #111; }
    :root.light-mode .subtitle { color: #6b7280; }
    :root.light-mode .header-tag { background: rgba(139,92,246,0.1); color: #6d28d9; }

    /* ── Settings button (gear) ──────────────────────────────────────── */
    .settings-btn {
      background: rgba(24,14,8,0.85);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-pill);
      color: var(--text-main);
      font-size: 18px;
      padding: 7px 11px;
      cursor: pointer;
      line-height: 1;
      transition: background 0.15s, transform 0.28s cubic-bezier(.175,.885,.32,1.275), border-color 0.15s;
    }

    .settings-btn:hover {
      background: rgba(139,92,246,0.18);
      border-color: var(--accent-main);
      transform: rotate(45deg);
    }

    :root.light-mode .settings-btn {
      background: rgba(255,255,255,0.9);
      border-color: rgba(0,0,0,0.15);
    }

    /* ── Settings overlay & slide-in panel ──────────────────────────── */
    .settings-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.55);
      z-index: 200; display: none;
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
    }

    .settings-overlay.open { display: block; }

    .settings-panel {
      position: fixed; top: 0; right: 0;
      height: 100%; width: 370px; max-width: 100vw;
      background: #020d14;
      border-left: 1px solid rgba(139,92,246,0.22);
      z-index: 201;
      transform: translateX(105%);
      transition: transform 0.28s cubic-bezier(.25,.46,.45,.94);
      display: flex; flex-direction: column; overflow: hidden;
      box-shadow: -24px 0 70px rgba(0,0,0,0.85);
    }

    .settings-panel.open { transform: translateX(0); }

    :root.light-mode .settings-panel {
      background: #ffffff;
      border-left-color: rgba(0,0,0,0.1);
      box-shadow: -10px 0 40px rgba(0,0,0,0.15);
    }

    .sett-hd {
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 20px 16px;
      border-bottom: 1px solid rgba(139,92,246,0.14);
      flex-shrink: 0;
    }

    .sett-hd h2 { font-size: 17px; font-weight: 700; }

    .sett-close {
      background: none; border: 1px solid var(--border-subtle);
      color: var(--text-main); border-radius: 999px;
      width: 30px; height: 30px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 13px;
      transition: background 0.12s, border-color 0.12s;
    }

    .sett-close:hover { background: rgba(139,92,246,0.15); border-color: var(--accent-main); }

    .sett-body {
      flex: 1; overflow-y: auto;
      padding: 16px 20px 40px;
      display: flex; flex-direction: column; gap: 22px;
    }

    .sett-sec { display: flex; flex-direction: column; gap: 10px; }

    .sett-sec-title {
      font-size: 10px; text-transform: uppercase;
      letter-spacing: 0.14em; color: var(--accent-main);
      font-weight: 700; padding-bottom: 6px;
