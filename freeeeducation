    function updateDocumentTitle() {
      if (currentGame) return;
      // Don't override if tab disguise is active
      if (typeof _tabDisguiseActive !== 'undefined' && _tabDisguiseActive) return;

      if (currentFilter === "home") {
        document.title = "Free Education • Home";
      } else if (currentFilter === "popular") {
        document.title = "Free Education • Popular";
      } else if (currentFilter === "new") {
        document.title = "Free Education • New Games";
      } else if (currentFilter === "all") {
        document.title = "Free Education • All Games";
      } else if (currentFilter === "suggestions") {
        document.title = "Free Education • Suggestions";
      } else {
        document.title = "Free Education • Play Free Web Games";
      }
    }

    function createCards() {
      if (currentFilter === "suggestions" || currentFilter === "home") return;

      const container = cardsRow;
      container.innerHTML = "";

      const search = (document.getElementById("searchInput").value || "").toLowerCase();
      const sorted = [...games].sort((a, b) => a.title.localeCompare(b.title));

      sorted.forEach((g) => {
        const text = (g.title + " " + (g.tags || "")).toLowerCase();
        if (search && !text.includes(search)) return;

        if (currentFilter === "popular" && !String(g.labels).includes("popular")) return;
        if (currentFilter === "new" && !String(g.labels).includes("new")) return;

        const isNew = String(g.labels).includes("new");
        const isPopular = String(g.labels).includes("popular");

        const card = document.createElement("div");
        card.className = "game-card";
        card.dataset.title = g.title;
        card.dataset.tags = g.tags || "";
        card.dataset.labels = g.labels || "";

        let badgeHTML = "";
        if (isNew) badgeHTML += `<div class="badge-pill badge-new">🆕 NEW</div>`;
        if (isPopular) badgeHTML += `<div class="badge-pill">🔥 Popular</div>`;

        const thumbSrc = getThumbSrc(g.folder);
        const hideImgs = typeof _settings !== 'undefined' && _settings.hideImages;
        const imgTag = hideImgs ? '' : `<img src="${thumbSrc}" alt="" loading="lazy"
          onload="this.parentElement.classList.remove('no-img')"
          onerror="this.remove()">`;

        card.innerHTML = `
  <div class="badge-row">
    ${badgeHTML}
  </div>
  <div class="game-thumb no-img">
    ${imgTag}
    <div class="play-circle">
      <div class="play-icon"></div>
    </div>
  </div>
  <div class="card-bottom">
    <div class="game-title">${g.title}</div>
    <div class="game-desc">${g.desc || "Play this game."}</div>
    <div class="play-link">
      Play Now <span class="arrow">▶</span>
    </div>
  </div>
`;

        card.addEventListener("click", () => openGame(g));
        container.appendChild(card);
      });
    }

    function updateViewForFilter() {
      document
