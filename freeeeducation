      if (currentFilter === "home") {
        homePanel.style.display = "block";
        suggestionsPanel.style.display = "none";
        cardsRow.style.display = "none";
        cardsRow.innerHTML = "";
        searchBoxEl.style.display = "none";
        return;
      }

      if (currentFilter === "suggestions") {
        homePanel.style.display = "none";
        cardsRow.style.display = "none";
        cardsRow.innerHTML = "";
        suggestionsPanel.style.display = "block";
        searchBoxEl.style.display = "none";
        return;
      }

      homePanel.style.display = "none";
      suggestionsPanel.style.display = "none";
      cardsRow.style.display = "grid";
      searchBoxEl.style.display = "flex";
      createCards();
    }

    function setFilter(name, fromHistory = false) {
