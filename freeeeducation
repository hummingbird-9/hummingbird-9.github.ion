      overlay.classList.remove("from-left");

      if (!fromHistory) {
        const gamePath = encodeURIComponent(game.folder);
        window.location.hash = "/" + gamePath;
      }
    }

    function closeGame() {
      overlay.classList.remove("open");
      gameFrame.src = "";
      currentGame = null;

      cheeseCreditEl.style.display = "none";
      cheeseCreditEl.innerHTML = "";

      loadingOverlay.classList.remove("hidden");
      updateDocumentTitle();
    }

    function handlePathChange() {
      const path = getCurrentPathName();

      if (!path) {
        if (overlay.classList.contains("open")) closeGame();
        if (currentFilter !== "home") {
          setFilter("home", true);
        } else {
          updateViewForFilter();
        }
        return;
      }

      const segments = path.split("/").filter(Boolean);
      const first = segments[0];

      const maybeFilter = slugToFilter(first);
      if (maybeFilter) {
        if (overlay.classList.contains("open")) closeGame();
        if (currentFilter !== maybeFilter) {
          setFilter(maybeFilter, true);
        } else {
          updateViewForFilter();
        }
        return;
      }

      const match = games.find(
        (g) => g.folder.toLowerCase() === first.toLowerCase()
      );

      if (match) {
        if (
          !overlay.classList.contains("open") ||
          !currentGame ||
          currentGame.folder !== match.folder
        ) {
          openGame(match, true);
        }
      } else {
        if (overlay.classList.contains("open")) closeGame();
        if (currentFilter !== "home") {
          setFilter("home", true);
        } else {
          updateViewForFilter();
        }
      }
    }

    function exitOverlay() {
      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
        return;
      }

      closeGame();

      const slug = filterToSlug(currentFilter);
      window.location.hash = slug ? "/" + slug : "/";
    }

    btnExit.addEventListener("click", exitOverlay);

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen()
          .then(() => {
            topBar.style.display = "none";
          })
          .catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    btnFullscreen.addEventListener("click", toggleFullscreen);

    document.addEventListener("fullscreenchange", () => {
      if (!document.fullscreenElement) {
        topBar.style.display = "flex";
      }
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.classList.contains("open") && !document.fullscreenElement) {
        exitOverlay();
      }
    });

    gameFrame.addEventListener("load", () => {
      setTimeout(() => {
        loadingOverlay.classList.add("hidden");
      }, 250);
    });

    window.addEventListener("hashchange", handlePathChange);

    window.addEventListener("load", () => {
      document.getElementById("year").textContent = new Date().getFullYear();
      handlePathChange();
      applyAllSettings();
    });

