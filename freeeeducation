  <script>
  // ─── HSV COLOR PICKER ────────────────────────────────────────────────────────

  let _cpH = 351, _cpS = 78, _cpV = 91; // default ≈ #38bdf8
  let _cpDragging = false, _cpSyncing = false;

  function cpHsvToHex(h, s, v) {
    s /= 100; v /= 100;
    const f = n => {
      const k = (n + h / 60) % 6;
      return v - v * s * Math.max(0, Math.min(k, 4 - k, 1));
    };
    const r = Math.round(f(5)*255), g = Math.round(f(3)*255), b = Math.round(f(1)*255);
    return '#' + [r,g,b].map(x => x.toString(16).padStart(2,'0')).join('');
  }

  function cpHexToHsv(hex) {
    let r=parseInt(hex.slice(1,3),16)/255, g=parseInt(hex.slice(3,5),16)/255, b=parseInt(hex.slice(5,7),16)/255;
    const max=Math.max(r,g,b), min=Math.min(r,g,b), d=max-min;
    let h=0, s=max===0?0:d/max, v=max;
    if(d){
      switch(max){
        case r: h=((g-b)/d+(g<b?6:0))/6; break;
        case g: h=((b-r)/d+2)/6; break;
        case b: h=((r-g)/d+4)/6; break;
      }
    }
    return [Math.round(h*360), Math.round(s*100), Math.round(v*100)];
  }

  function cpUpdateVisuals() {
    const square = document.getElementById('cpSquare');
    const cursor = document.getElementById('cpCursor');
    const hueEl  = document.getElementById('cpHue');
    const thumb  = document.getElementById('cpHueThumb');
    const prev   = document.getElementById('cpPreview');
    const hexIn  = document.getElementById('colorHexInput');
    if (!square) return;
    // Square gradient: white→hueColor left-right, transparent→black top-bottom
    square.style.background = `linear-gradient(to bottom, transparent, #000), linear-gradient(to right, #fff, hsl(${_cpH},100%,50%))`;
    // Cursor position
    cursor.style.left = _cpS + '%';
    cursor.style.top  = (100 - _cpV) + '%';
    // Hue thumb
    thumb.style.left = (_cpH / 360 * 100) + '%';
    thumb.style.background = `hsl(${_cpH},100%,50%)`;
    // Preview + hex
    const hex = cpHsvToHex(_cpH, _cpS, _cpV);
    if (prev) prev.style.background = hex;
    if (hexIn && document.activeElement !== hexIn) hexIn.value = hex;
  }

  function cpSyncFromHex(hex) {
    if (!/^#[0-9a-fA-F]{6}$/.test(hex)) return;
    _cpSyncing = true;
    [_cpH, _cpS, _cpV] = cpHexToHsv(hex);
    cpUpdateVisuals();
    syncSwatches(hex);
    _cpSyncing = false;
  }

  function cpSquarePointer(e) {
    const square = document.getElementById('cpSquare');
    const rect = square.getBoundingClientRect();
    const cx = e.touches ? e.touches[0].clientX : e.clientX;
    const cy = e.touches ? e.touches[0].clientY : e.clientY;
    _cpS = Math.round(Math.max(0, Math.min(1, (cx - rect.left) / rect.width)) * 100);
    _cpV = Math.round((1 - Math.max(0, Math.min(1, (cy - rect.top) / rect.height))) * 100);
    cpUpdateVisuals();
    if (!_cpSyncing) applyAccentColor(cpHsvToHex(_cpH, _cpS, _cpV));
  }

  function cpHuePointer(e) {
    const hueEl = document.getElementById('cpHue');
    const rect = hueEl.getBoundingClientRect();
    const cx = e.touches ? e.touches[0].clientX : e.clientX;
    _cpH = Math.round(Math.max(0, Math.min(1, (cx - rect.left) / rect.width)) * 360);
    cpUpdateVisuals();
    if (!_cpSyncing) applyAccentColor(cpHsvToHex(_cpH, _cpS, _cpV));
  }

  function cpInit() {
    const square = document.getElementById('cpSquare');
    const hueEl  = document.getElementById('cpHue');
    if (!square || square._cpInited) return;
    square._cpInited = true;

    // Square drag
    let draggingSquare = false;
    square.addEventListener('mousedown', e => { draggingSquare=true; cpSquarePointer(e); e.preventDefault(); });
    square.addEventListener('touchstart', e => { draggingSquare=true; cpSquarePointer(e); e.preventDefault(); }, {passive:false});
    document.addEventListener('mousemove', e => { if(draggingSquare) cpSquarePointer(e); });
    document.addEventListener('touchmove', e => { if(draggingSquare) cpSquarePointer(e); }, {passive:false});
    document.addEventListener('mouseup',  () => draggingSquare=false);
    document.addEventListener('touchend', () => draggingSquare=false);

    // Hue drag
    let draggingHue = false;
    hueEl.addEventListener('mousedown', e => { draggingHue=true; cpHuePointer(e); e.preventDefault(); });
    hueEl.addEventListener('touchstart', e => { draggingHue=true; cpHuePointer(e); e.preventDefault(); }, {passive:false});
    document.addEventListener('mousemove', e => { if(draggingHue) cpHuePointer(e); });
    document.addEventListener('touchmove', e => { if(draggingHue) cpHuePointer(e); }, {passive:false});
    document.addEventListener('mouseup',  () => draggingHue=false);
    document.addEventListener('touchend', () => draggingHue=false);

    cpUpdateVisuals();
  }

  // ─── SETTINGS ────────────────────────────────────────────────────────────────

  const SETTINGS_KEY = "fe_settings";
  let _settings = {};
  function loadSettings() {
    try { _settings = JSON.parse(localStorage.getItem(SETTINGS_KEY) || "{}"); } catch(e) { _settings = {}; }
  }

  function saveSettings() {
    localStorage.setItem(SETTINGS_KEY, JSON.stringify(_settings));
  }

  // ── Accent color ──────────────────────────────────────────────────────────────
  function hexToHsl(hex) {
    let r = parseInt(hex.slice(1,3),16)/255, g = parseInt(hex.slice(3,5),16)/255, b = parseInt(hex.slice(5,7),16)/255;
    const max = Math.max(r,g,b), min = Math.min(r,g,b);
    let h, s, l = (max+min)/2;
    if (max===min) { h=s=0; } else {
      const d = max-min; s = l>0.5 ? d/(2-max-min) : d/(max+min);
      switch(max){ case r: h=((g-b)/d+(g<b?6:0))/6; break; case g: h=((b-r)/d+2)/6; break; case b: h=((r-g)/d+4)/6; break; }
    }
    return [Math.round(h*360), Math.round(s*100), Math.round(l*100)];
  }

  function hslToHex(h, s, l) {
    s/=100; l/=100;
    const a=s*Math.min(l,1-l);
    const f=n=>{const k=(n+h/30)%12; const c=l-a*Math.max(-1,Math.min(k-3,Math.min(9-k,1))); return Math.round(255*c).toString(16).padStart(2,'0');};
    return '#'+f(0)+f(8)+f(4);
  }

  function applyAccentColor(hex) {
    if (!/^#[0-9a-fA-F]{6}$/.test(hex)) return;
    const [h, s, l] = hexToHsl(hex);
    const soft  = hslToHex(h, Math.min(s+5,100), Math.min(l+8,90));
    const warm  = hslToHex(h, Math.min(s+8,100), Math.min(l+18,92));
    const r = document.documentElement.style;
    r.setProperty('--accent-main', hex);
    r.setProperty('--accent-soft', soft);
    r.setProperty('--accent-warm', warm);
    // update gradient
    document.body.style.background = `radial-gradient(circle at top, ${hexToRgba(hex,0.08)} 0, #000000 65%), linear-gradient(to bottom, var(--bg-page-top), var(--bg-page-bottom))`;
    _settings.accentColor = hex;
    saveSettings();
    syncSwatches(hex);
    const _hi = document.getElementById('colorHexInput');
    const _ni = document.getElementById('colorPickerNative');
    if (_hi && document.activeElement !== _hi) _hi.value = hex;
    if (_ni) _ni.value = hex;
    // Sync visual picker without re-triggering applyAccentColor
    if (!_cpSyncing) cpSyncFromHex(hex);
  }

  function hexToRgba(hex, a) {
    const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
    return `rgba(${r},${g},${b},${a})`;
  }

  function syncSwatches(hex) {
    document.querySelectorAll('.swatch').forEach(s => {
      s.classList.toggle('active', s.dataset.color.toLowerCase() === hex.toLowerCase());
    });
  }

  function pickSwatch(el) {
    applyAccentColor(el.dataset.color);
  }

  let _colorModeIsPicker = true;
  function toggleColorMode() {
    _colorModeIsPicker = !_colorModeIsPicker;
    document.getElementById('colorPickerPanel').style.display = _colorModeIsPicker ? '' : 'none';
    const panel = document.getElementById('pastColorsPanel');
    panel.style.display = _colorModeIsPicker ? 'none' : 'flex';
    document.getElementById('cpToggleBtn').textContent = _colorModeIsPicker ? 'Past colors' : 'Color picker';
  }

  function onNativeColorChange(val) {
    document.getElementById('colorHexInput').value = val;
    applyAccentColor(val);
  }

  function onHexInput(val) {
    if (/^#[0-9a-fA-F]{6}$/.test(val)) {
      document.getElementById('colorPickerNative').value = val;
      syncSwatches(val);
    }
  }

  function applyHexInput() {
    const val = document.getElementById('colorHexInput').value.trim();
    applyAccentColor(val);
  }

  // ── Light mode ────────────────────────────────────────────────────────────────
  function applyLightMode(on) {
    document.documentElement.classList.toggle('light-mode', on);
    _settings.lightMode = on;
    saveSettings();
    document.getElementById('togLightMode').checked = on;
  }

  function onToggleLightMode(on) {
    applyLightMode(on);
  }


  // ── Hide images ───────────────────────────────────────────────────────────────
  function applyHideImages(on) {
    _settings.hideImages = on;
    saveSettings();
    document.getElementById('togHideImages').checked = on;
    if (['all','popular','new','home'].includes(currentFilter)) {
      updateViewForFilter();
    }
  }

  function onToggleHideImages(on) {
    applyHideImages(on);
  }

  // ── Tab Disguise ──────────────────────────────────────────────────────────────
  let _tabDisguiseActive = false;
  let _tabDisguiseTitle  = '';
  let _tabDisguiseIcon   = '';

  function setTabPreset(title, iconUrl) {
    document.getElementById('tabTitleInput').value = title;
    document.getElementById('tabIconInput').value  = iconUrl;
  }

  function applyTabDisguise() {
    const title = document.getElementById('tabTitleInput').value.trim();
    const icon  = document.getElementById('tabIconInput').value.trim();
    _tabDisguiseTitle  = title;
    _tabDisguiseIcon   = icon;
    _tabDisguiseActive = !!title;
    _settings.tabTitle = title;
    _settings.tabIcon  = icon;
    saveSettings();
    updateDocumentTitle();
    let link = document.querySelector("link[rel~='icon']");
    if (!link) { link = document.createElement('link'); link.rel = 'icon'; document.head.appendChild(link); }
    link.href = icon || '/favicon.ico';
  }

  function updateDocumentTitle() {
    if (_tabDisguiseActive && _tabDisguiseTitle) {
      document.title = _tabDisguiseTitle;
    } else if (currentGame) {
      document.title = currentGame.title + ' • Free Education';
    } else {
      document.title = 'Free Education • Play Free Web Games';
    }
  }

  // ── Export / Import ───────────────────────────────────────────────────────────
  function exportData() {
    const data = {};
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      data[k] = localStorage.getItem(k);
    }
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = 'freeeducation-backup.json';
    a.click();
    URL.revokeObjectURL(url);
  }

  function handleImportFile(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      try {
        const data = JSON.parse(ev.target.result);
        Object.entries(data).forEach(([k,v]) => localStorage.setItem(k, v));
        alert('✅ Data imported! Refreshing settings...');
        applyAllSettings();
      } catch(err) { alert('❌ Invalid backup file.'); }
    };
    reader.readAsText(file);
    e.target.value = '';
  }

  // ── Apply all on load ─────────────────────────────────────────────────────────
  function applyAllSettings() {
    loadSettings();
    const s = _settings;

    if (s.accentColor) {
      applyAccentColor(s.accentColor);
    } else {
      syncSwatches('#38bdf8');
      document.getElementById('colorHexInput').value = '#38bdf8';
      document.getElementById('colorPickerNative').value = '#38bdf8';
    }

    applyLightMode(!!s.lightMode);
    applyHideImages(!!s.hideImages);

    if (s.tabTitle) {
      document.getElementById('tabTitleInput').value = s.tabTitle || '';
      document.getElementById('tabIconInput').value  = s.tabIcon  || '';
      _tabDisguiseTitle  = s.tabTitle || '';
      _tabDisguiseIcon   = s.tabIcon  || '';
      _tabDisguiseActive = !!s.tabTitle;
      updateDocumentTitle();
      let link = document.querySelector("link[rel~='icon']");
      if (!link) { link = document.createElement('link'); link.rel = 'icon'; document.head.appendChild(link); }
      if (s.tabIcon) link.href = s.tabIcon;
    }

    cpSyncFromHex(s.accentColor || '#38bdf8');
    cpInit();
  }
  </script>
</body>
</html>
